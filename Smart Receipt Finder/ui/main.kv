#:import dp kivy.metrics.dp

MDScreen:

    MDNavigationLayout:

        ScreenManager:
            id: screen_manager

            MainScreen:
                name: "main"

            DetailScreen:
                name: "detail"

            FavoriteScreen:
                name: "favorite"

        MDNavigationDrawer:
            id: nav_drawer
            radius: (0, 16, 16, 0)

            BoxLayout:
                orientation: "vertical"
                spacing: dp(10)
                padding: dp(20)

                Image:
                    source: "assets/images/logo.jpg"
                    size_hint: None, None
                    size: "120dp", "120dp"
                    pos_hint: {"center_x": 0.5}
                    allow_stretch: True

                MDLabel:
                    text: "Recipe Finder"
                    font_style: "H5"
                    size_hint_y: None
                    height: self.texture_size[1]

                MDLabel:
                    text: "Smart Cooking Assistant"
                    theme_text_color: "Secondary"
                    size_hint_y: None
                    height: self.texture_size[1]

                Widget:

                OneLineIconListItem:
                    text: "Home"
                    on_release:
                        app.root.ids.screen_manager.current = "main"
                        nav_drawer.set_state("close")

                    IconLeftWidget:
                        icon: "home"

                OneLineIconListItem:
                    text: "Favorites"
                    on_release:
                        root.manager.current = "favorite"
                        app.root.ids.screen_manager.get_screen("favorite").load_favorites()
                        nav_drawer.set_state("close")

                    IconLeftWidget:
                        icon: "heart"

                OneLineIconListItem:
                    text: "Toggle Theme"
                    on_release:
                        app.toggle_theme()
                        nav_drawer.set_state("close")

                    IconLeftWidget:
                        icon: "theme-light-dark"

                Widget:

                MDRaisedButton:
                    text: "Close Menu"
                    on_release:
                        nav_drawer.set_state("close")


<MainScreen>:

    BoxLayout:
        orientation: "vertical"

        MDTopAppBar:
            title: "Smart Recipe Finder"
            elevation: 4
            left_action_items:
                [["menu", lambda x: app.root.ids.nav_drawer.set_state("open")]]

        BoxLayout:
            orientation: "vertical"
            spacing: dp(10)
            padding: dp(10)

            MDTextField:
                id: category_input
                hint_text: "Enter category"
                mode: "rectangle"

            MDTextField:
                id: ingredients_input
                hint_text: "Enter ingredients"
                mode: "rectangle"

            BoxLayout:
                size_hint_y: None
                height: dp(50)
                spacing: dp(10)

                MDRaisedButton:
                    text: "Find Recipes"
                    on_release: root.find_recipes()

                MDRaisedButton:
                    text: "Favorites"
                    on_release:
                        app.root.ids.screen_manager.current = "favorite"
                        app.root.ids.screen_manager.get_screen("favorite").load_favorites()

            ScrollView:

                MDList:
                    id: recipe_list
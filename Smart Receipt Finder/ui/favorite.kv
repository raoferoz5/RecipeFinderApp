<FavoriteScreen>:
    BoxLayout:
        orientation: "vertical"
        
        MDTopAppBar:
            title: "Favorite Recipes"
            # Change 'set_current("main")' to 'current = "main"'
            left_action_items: [["arrow-left", lambda x: setattr(app.root.ids.screen_manager, 'current', 'main')]]

        ScrollView:
            MDList:
                id: fav_list